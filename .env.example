# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Threads — AKUN BOT (satu akun yang melakukan semua post)
THREADS_BOT_USER_ID=
THREADS_BOT_ACCESS_TOKEN=
# Token verifikasi webhook (isi bebas, harus sama dengan yang didaftarkan di Meta)
WEBHOOK_VERIFY_TOKEN=ganti_dengan_token_acak

# API key untuk akses modul fitur (/contents, /campaigns, /threads/publish)
API_KEY=ganti_dengan_api_key_acak

# AI Provider (OpenAI-compatible)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: endpoint khusus (misal proxy/ollama). Default: https://api.openai.com/v1
AI_BASE_URL=
