# Server
PORT=8000

# Browser automation (Chromium)
# Profil persisten berisi session login — sudah di-gitignore, JANGAN di-commit.
THREADS_PROFILE_DIR=.data/chromium-profile

# Opsional: bootstrap session dari cookie browser yang sudah ada.
# Dipakai bootstrapCookiesFromEnv() supaya tidak perlu login manual.
# Kalau dikosongkan, jalankan `bun run login:threads` sekali.
THREADS_COOKIE=

BROWSER_HEADLESS=true
BROWSER_CHANNEL=chrome
BROWSER_SLOWMO_MS=120

# true = tidak benar-benar klik apa pun (hanya log rencana aksi)
DRY_RUN=true

# Rate limit aksi tulis (post/like/reply/repost)
ACTION_MIN_DELAY_MS=45000
ACTION_MAX_DELAY_MS=150000
ACTION_MAX_PER_HOUR=20

# LLM untuk menyusun balasan (WAJIB untuk tool counter/reply).
# Balasan hanya dibuat oleh LLM dan wajib bersumber data internet; tanpa key,
# counter menolak jalan dan tidak ada balasan yang dikirim.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Endpoint OpenAI-compatible. Ganti kalau pakai OpenRouter/Groq/LLM lokal.
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=30000
