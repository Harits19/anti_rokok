# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Database (SQLite)
DATABASE_PATH=./data/anti_rokok.db

# Threads (Meta Graph API)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:3000/threads/oauth/callback
# Token verifikasi webhook (isi bebas, harus sama dengan yang didaftarkan di Meta)
WEBHOOK_VERIFY_TOKEN=ganti_dengan_token_acak

# AI Provider (OpenAI-compatible)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: endpoint khusus (misal proxy/ollama). Default: https://api.openai.com/v1
AI_BASE_URL=
